{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "graphql",
      "camelcase": "GraphQL",
      "scope": "source.graphql",
      "path": ".",
      "file-types": [
        "graphql",
        "gql",
        "graphqls"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^graphql$"
    },
    {
      "name": "graphql_schema_coordinate",
      "camelcase": "GraphQLSchemaCoordinate",
      "scope": "source.graphql-schema-coordinate",
      "path": "schema_coordinate",
      "file-types": []
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "GraphQL grammar for tree-sitter",
    "authors": [
      {
        "name": "Bryan Kegley",
        "email": "hi@bryankegley.me"
      }
    ],
    "links": {
      "repository": "https://github.com/blquinn/tree-sitter-graphql"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
