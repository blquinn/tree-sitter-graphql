{
  "name": "tree-sitter-graphql",
  "version": "0.1.0",
  "description": "GraphQL grammar for tree-sitter",
  "repository": "github:blquinn/tree-sitter-graphql",
  "license": "MIT",
  "author": {
    "name": "Bryan Kegley",
    "email": "hi@bryankegley.me"
  },
  "type": "module",
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "graphql"
  ],
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "prebuildify": "^6.0.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
